{
  "expo": {
    "name": "Soul Link",
    "slug": "soul-link",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "soul-link",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.soullink.app"
    },
    "android": {
      "package": "com.soullink.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "react-native-reanimated/plugin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Soul Link to access your photos so you can share your reflections."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Soul Link to save images to your gallery.",
          "savePhotosPermission": "Allow Soul Link to save images to your gallery."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b889bf31-7e59-4db1-b521-47a0aa585c4b"
      }
    },
    "owner": "npmsadiq"
  }
}
