{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "20.18.0",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "COREPACK_ENABLE": "1"
      }
    },
    "preview": {
      "node": "20.18.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "COREPACK_ENABLE": "1"
      }
    }
  }
}